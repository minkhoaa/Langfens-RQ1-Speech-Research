  "operating_parameters": {
    "routing_semantics": {
      "substitution_score": "p_neural_S from ScalarMixingTargetHead probs_target_neural[:, 1]",
      "omission_score": "p_fixed_O from 50/50 fused target simplex probs_target_fixed[:, 2]",
      "insertion_score": "p_gap_I from ScalarMixingGapHead probs_gap"
    },
    "arbitration_rule": "score_margin",
    "arbitration_semantics": "Target event flags warning if p_neural_S >= tau_S or p_fixed_O >= tau_O. If both trigger: margin_S = p_neural_S - tau_S, margin_O = p_fixed_O - tau_O. If margin_S > margin_O -> SUBSTITUTION; if margin_O > margin_S -> OMISSION; if margin_S == margin_O -> tie_hash(event_id) % 2 == 1 ? SUBSTITUTION : OMISSION. If neither triggers -> CORRECT (label 0). Gap event flags INSERTION if p_gap_I >= tau_I (tie_hash >= cutoff if equal).",
    "tie_hash_specification": "uint64_be(sha256(\"LANGFENS-MB07-warning-tie-v1:\" + str(event_id))[:8])",
